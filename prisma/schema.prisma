generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  firstName             String?
  lastName              String?
  fullName              String?
  city                  String?
  state                 String?
  citystate             String?
  displayName           String?                @unique
  email                 String?                @unique
  emailVerified         DateTime?
  showReviews           Boolean                @default(true)
  image                 String?
  accounts              Account[]
  sessions              Session[]
  role                  Role                   @default(USER)
  reviews               Review[]
  stars                 Star[]
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
  preferences           UserPreferences[]
  bookmarks             BookmarksByUser[]
  notifications         Notification[]
}

model Property {
  id            String            @id @default(cuid())
  slug          String            @unique
  street        String
  unit          String?
  city          String
  state         String
  zipcode       String
  reviews       Review[]
  stars         Star[]
  bookmarkedBy  BookmarksByUser[]
  notifications Notification[]
}

model Review {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId     String
  stars          Star[]
  comment        String
  street         String
  citystate      String
  propertySlug   String
  flagged        Boolean   @default(false)
  edited         Boolean   @default(false)
  editedAt       DateTime?
  landlordRating String?
  safetyRating   String?
  moveoutRating  String?
  votes          Int?
  response       Review?   @relation("ReviewResponse", fields: [responseId], references: [id])
  responseId     Int?      @unique
  originalReview Review?   @relation("ReviewResponse")
}

model Star {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?
  review     Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int?
  stars      Int
}

model Notification {
  id                    Int                    @id @default(autoincrement())
  createdAt             DateTime               @default(now())
  message               String
  description           String
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
  property              Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId            String?
  userId                String?
}

model NotificationActive {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
}

model NotificationComplete {
  id             String       @id
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
}

model UserPreferences {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  system         Boolean  @default(true)
  productUpdates Boolean  @default(true)
  bookmarkUpdate Boolean  @default(true)
  reviewUpdate   Boolean  @default(true)
  showReviews    Boolean  @default(true)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

model BookmarksByUser {
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())

  @@id([propertyId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

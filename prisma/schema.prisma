generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  fullName      String?
  city          String?
  state         String?
  citystate     String?
  displayName   String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  showReviews   Boolean   @default(true)
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          Role      @default(USER)
  reviews       Review[]
}

model Property {
  id      String   @id @default(cuid())
  slug    String   @unique
  stars   Int[]
  street  String
  unit    String?
  city    String
  state   String
  zipcode String
  reviews Review[]
}

model Review {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  property       Property @relation(fields: [propertyId], references: [id])
  propertyId     String
  stars          Int
  comment        String
  street         String
  citystate      String
  propertySlug   String
  landlordRating String?
  safetyRating   String?
  moveoutRating  String?
  votes          Int?
  response       Review?  @relation("ReviewResponse", fields: [responseId], references: [id])
  responseId     String?  @unique
  originalReview Review?  @relation("ReviewResponse")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  image                 String?
  email                 String?                @unique
  displayName           String?                @unique
  citystate             String?
  name                  String?
  city                  String?
  state                 String?
  firstName             String?
  lastName              String?
  fullName              String?
  emailVerified         DateTime?
  showReviews           Boolean                @default(true)
  accounts              Account[]
  sessions              Session[]
  role                  Role                   @default(USER)
  status                Status                 @default(ACTIVE)
  reviews               Review[]
  stars                 Star[]
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
  preferences           UserPreferences[]
  bookmarks             BookmarksByUser[]
  post                  Post[]
}

model Property {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  street               String
  unit                 String?
  city                 String
  state                String
  zipcode              String
  reviews              Review[]
  stars                Star[]
  bookmarkedBy         BookmarksByUser[]
  NotificationActive   NotificationActive[]
  NotificationComplete NotificationComplete[]
}

model Review {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId     String
  comment        String
  street         String
  citystate      String
  propertySlug   String
  flagged        Boolean   @default(false)
  edited         Boolean   @default(false)
  editedAt       DateTime?
  landlordRating String?
  safetyRating   String?
  moveoutRating  String?
  votes          Int?
  stars          Star?
  response       Review?   @relation("ReviewResponse", fields: [responseId], references: [id])
  responseId     Int?      @unique
  originalReview Review?   @relation("ReviewResponse")
}

model Star {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?
  review     Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int       @unique
  stars      Int
}

model Notification {
  id                    Int                    @id @default(autoincrement())
  createdAt             DateTime               @default(now())
  message               String
  description           String
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
}

model NotificationActive {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  propertyId String?
}

model NotificationComplete {
  id             String       @id
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  propertyId String?
}

model UserPreferences {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  system          Boolean  @default(true)
  productUpdates  Boolean  @default(true)
  bookmarkUpdates Boolean  @default(true)
  reviewUpdates   Boolean  @default(true)
  showReviews     Boolean  @default(true)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
}

model BookmarksByUser {
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  assignedAt DateTime @default(now())

  @@id([propertyId, userId])
}

model Post {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  title      String   @unique
  slug       String   @unique
  published  Boolean  @default(true)
  authorId   Int
  isFeatured Boolean  @default(false)
  excerpt    String
  body       String
  author     User     @relation(fields: [authorId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  ARCHIVED
}
